[
  {"id": 1, "text": "Bugün özgür bir nefes için harika bir gün."},
  {"id": 2, "text": "İçmediğin her sigara, sağlığın için bir kazançtır."},
  {"id": 3, "text": "Daha temiz bir nefes, daha güçlü bir sen demek."},
  {"id": 4, "text": "Kendine verdiğin sözleri tutuyorsun, devam et."},
  {"id": 5, "text": "Bedenin seni destekliyor, onu dinle."},
  {"id": 6, "text": "Her dakika, sigarasız bir geleceğe adım."},
  {"id": 7, "text": "Bugün enerjin daha yüksek, fark et."},
  {"id": 8, "text": "Daha sakin ve dengeli bir zihin için doğru yoldasın."},
  {"id": 9, "text": "Ailen ve sevdiklerin için güzel bir seçim yapıyorsun."},
  {"id": 10, "text": "Zor anlar geçici, kararın kalıcı."},
  {"id": 11, "text": "Küçük adımlar, büyük başarılar getirir."},
  {"id": 12, "text": "Sigara isteği dalga gibidir, gelir ve geçer."},
  {"id": 13, "text": "Daha temiz bir cilt ve daha güçlü bir beden seni bekliyor."},
  {"id": 14, "text": "Bugün kendine iyi bakma günün."},
  {"id": 15, "text": "Gücün, alışkanlıklarından daha büyük."},
  {"id": 16, "text": "Sigara bırakma yolculuğunda her gün bir başarıdır."},
  {"id": 17, "text": "Nefesin açıldıkça hayatın da açılıyor."},
  {"id": 18, "text": "Kendinle gurur duy, doğru yoldasın."},
  {"id": 19, "text": "Bir bardak su iç, isteğin azalabilir."},
  {"id": 20, "text": "Dışarı çık ve temiz havayı hisset."},
  {"id": 21, "text": "Bugün de sigarasız kalmayı seçiyorsun."},
  {"id": 22, "text": "İçmediğin her sigara, cebinde birikim."},
  {"id": 23, "text": "Daha iyi uyku için harika bir karar verdin."},
  {"id": 24, "text": "Sağlıklı kalp, sigarasız hayatla başlar."},
  {"id": 25, "text": "Kendine nazik ol, süreç zaman ister."},
  {"id": 26, "text": "Bugün güçlü, yarın daha da güçlü."},
  {"id": 27, "text": "Nefes alışın derinleşiyor, fark et."},
  {"id": 28, "text": "Kötü alışkanlıkları geride bırakıyorsun."},
  {"id": 29, "text": "Kendine verdiğin değeri artırıyorsun."},
  {"id": 30, "text": "Daha uzun ve kaliteli bir yaşam için ilerliyorsun."},
  {"id": 31, "text": "İsteğin geldiğinde kısa bir yürüyüş iyi gelir."},
  {"id": 32, "text": "Bugün özgürlüğün tadını çıkar."},
  {"id": 33, "text": "Dikkatini başka şeye ver, istek azalır."},
  {"id": 34, "text": "Sağlığın en değerli yatırımın."},
  {"id": 35, "text": "Her gün daha rahat nefes alacaksın."},
  {"id": 36, "text": "Sigarasız bir gün daha, harikasın."},
  {"id": 37, "text": "İrade kas gibidir, kullandıkça güçlenir."},
  {"id": 38, "text": "Bugün de kendini seçtin."},
  {"id": 39, "text": "Bir derin nefes al ve devam et."},
  {"id": 40, "text": "Küçük bir mola ver, su iç."},
  {"id": 41, "text": "Kendine güven, başaracaksın."},
  {"id": 42, "text": "Yeni bir alışkanlık inşa ediyorsun."},
  {"id": 43, "text": "Her an bir fırsat, sigarasız kal."},
  {"id": 44, "text": "Bugün daha berrak bir zihinle geçiyor."},
  {"id": 45, "text": "Zor anlarda nefese odaklan."},
  {"id": 46, "text": "Sigarayı bırakmak, kendine saygıdır."},
  {"id": 47, "text": "Kazandığın zaman sana geri dönüyor."},
  {"id": 48, "text": "Kendini ödüllendirecek güzel bir şey planla."},
  {"id": 49, "text": "İstek geldiğinde 5 dakika ertele, geçecek."},
  {"id": 50, "text": "Bugün bedenin iyileşmeye devam ediyor."},
  {"id": 51, "text": "Daha canlı bir yaşam için doğru yoldasın."},
  {"id": 52, "text": "Temiz bir nefes, temiz bir başlangıç."},
  {"id": 53, "text": "Gün içinde kısa esneme hareketleri yap."},
  {"id": 54, "text": "Daha iyi koku ve tat alma seni bekliyor."},
  {"id": 55, "text": "Bugün de kararının arkasındasın."},
  {"id": 56, "text": "Sigarasız hayat, daha fazla enerji demek."},
  {"id": 57, "text": "Güçlü kal, bu senin hikayen."},
  {"id": 58, "text": "Nefesini iyileştiren her gün sana güç katar."},
  {"id": 59, "text": "Zorlandığında destek almayı unutma."},
  {"id": 60, "text": "Bugün daha sağlıklı seçimler yapıyorsun."},
  {"id": 61, "text": "Mola anlarını çay veya suyla değiştir."},
  {"id": 62, "text": "İçmediğin sigaralarla hedeflerine yaklaşıyorsun."},
  {"id": 63, "text": "Sigarasız günlerin sayısı artıyor."},
  {"id": 64, "text": "Daha fazla özgürlük için devam."},
  {"id": 65, "text": "Bugün kendine verdiğin sözün günü."},
  {"id": 66, "text": "Kararın seni daha güçlü yapıyor."},
  {"id": 67, "text": "Nefes almanın keyfini çıkar."},
  {"id": 68, "text": "Kendine nazik ol, gelişiyorsun."},
  {"id": 69, "text": "Bugün de sağlığın için bir adım."},
  {"id": 70, "text": "İstek geldiğinde kısa bir iş değişikliği yap."},
  {"id": 71, "text": "Sigarasız kalmak mümkün, bunu yaşıyorsun."},
  {"id": 72, "text": "Daha parlak bir gelecek için devam et."},
  {"id": 73, "text": "Vücudun teşekkür ediyor."},
  {"id": 74, "text": "Kendi gücünü her gün kanıtlıyorsun."},
  {"id": 75, "text": "Bugün nefesin daha ferah."},
  {"id": 76, "text": "Sigarayı bırakmak, kendine yatırım."},
  {"id": 77, "text": "Düşüncelerini başka bir şeye çevir."},
  {"id": 78, "text": "Sağlıklı bir hayat için doğru karar."},
  {"id": 79, "text": "Her yeni gün, yeni bir fırsat."},
  {"id": 80, "text": "Bugün sigarasız kalmak harika bir başarı."},
  {"id": 81, "text": "Kendine duyduğun güven artıyor."},
  {"id": 82, "text": "Nefesin güçlenirken bedenin rahatlıyor."},
  {"id": 83, "text": "Küçük bir yürüyüş seni rahatlatabilir."},
  {"id": 84, "text": "Sigara içmeme kararı sana ait."},
  {"id": 85, "text": "Bugün de sağlıklı bir adım attın."},
  {"id": 86, "text": "İstek hissettiğinde birine mesaj at."},
  {"id": 87, "text": "Sigarasızlık, daha temiz bir yaşam."},
  {"id": 88, "text": "Kendini takdir etmeyi unutma."},
  {"id": 89, "text": "Her gün daha güçlü bir irade."},
  {"id": 90, "text": "Bugün iyi bir seçim yaptın."},
  {"id": 91, "text": "Daha taze bir nefes seni bekliyor."},
  {"id": 92, "text": "Sağlığın için verdiğin karar değerli."},
  {"id": 93, "text": "Sigarasız kalmak seni özgürleştirir."},
  {"id": 94, "text": "Zihnini meşgul edecek bir hobi bul."},
  {"id": 95, "text": "Bugün daha huzurlu bir gün."},
  {"id": 96, "text": "Kendine inan, bu yolda ilerliyorsun."},
  {"id": 97, "text": "Her nefesin daha değerli."},
  {"id": 98, "text": "Sigarayı bırakmak, daha iyi bir yaşam."},
  {"id": 99, "text": "İstek geldiğinde derin nefes al."},
  {"id": 100, "text": "Bugün sigarasızlığın tadını çıkar."},
  {"id": 101, "text": "Gücün, alışkanlıkların üzerinde."},
  {"id": 102, "text": "Yolun açık, hedefin net."},
  {"id": 103, "text": "Her gün daha sağlıklı bir sen."},
  {"id": 104, "text": "İçmediğin her sigara sana yaşam katar."},
  {"id": 105, "text": "Bugün kararlılığını güçlendir."},
  {"id": 106, "text": "Kendine zaman ayır, dinlen."},
  {"id": 107, "text": "Sigarasız günlerin birikiyor."},
  {"id": 108, "text": "Sağlığını seçtiğin için teşekkürler."},
  {"id": 109, "text": "Bugün de doğru yoldasın."},
  {"id": 110, "text": "Nefesin her gün biraz daha rahat."},
  {"id": 111, "text": "Sigarasız hayat, daha fazla güç."},
  {"id": 112, "text": "İradene güven, kararına sadık kal."},
  {"id": 113, "text": "Bugün daha hafif hissediyorsun."},
  {"id": 114, "text": "Güçlü kal, bu süreç geçici."},
  {"id": 115, "text": "Nefesini korumak, kendini korumaktır."},
  {"id": 116, "text": "Kendini motive et, devam et."},
  {"id": 117, "text": "Bugün sigarasız bir zafer."},
  {"id": 118, "text": "Kendine iyi bakmanın en güzel hali."},
  {"id": 119, "text": "Daha kaliteli bir yaşam için adım atıyorsun."},
  {"id": 120, "text": "Bugün de sigarasız kalmayı seçtin."}
]
